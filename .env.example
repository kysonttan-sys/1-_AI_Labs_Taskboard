# Database connection string
#   Local dev:        postgresql://postgres@127.0.0.1:5433/taskboard_test
#   Render Postgres:  postgresql://user:pass@host/db?sslmode=require  (SSL REQUIRED on Render)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Session encryption secret (generate with: openssl rand -hex 32)
# Required in production. server.ts will throw on boot without it.
SESSION_SECRET=""

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# TURN server for WebRTC meetings (optional; format: turn:host:port or turns:host:port)
# TURN_SERVER_URL=turn:turn.example.com:3478
# TURN_SHARED_SECRET=your-static-auth-secret
# TURN_EXPIRY_SECONDS=86400

# Local Ollama AI assistant via Tailscale Funnel
# OLLAMA_URL is the https://*.ts.net URL exposed by Tailscale Funnel on your PC.
# OLLAMA_MODEL is the model pulled locally (e.g. llama3.1).
# IMPORTANT: Ollama itself has NO built-in API-key auth. You MUST put Caddy/Nginx
# with bearer-token or basic auth in front of Ollama, then funnel that proxy.
# OLLAMA_API_KEY or OLLAMA_BASIC_AUTH is checked by your reverse proxy, NOT Ollama.
OLLAMA_URL="https://your-pc.tailnet-name.ts.net"
OLLAMA_MODEL="llama3.1"
# OLLAMA_API_KEY="your-reverse-proxy-bearer-token"
# OLLAMA_BASIC_AUTH="username:password"
