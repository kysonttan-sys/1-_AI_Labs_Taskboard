# Database connection string
#   Local dev:        postgresql://postgres@127.0.0.1:5433/taskboard_test
#   Render Postgres:  postgresql://user:pass@host/db?sslmode=require  (SSL REQUIRED on Render)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Session encryption secret (generate with: openssl rand -hex 32)
# Required in production. server.ts will throw on boot without it.
SESSION_SECRET=""

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI / Ollama — see docs/ollama-tunnel.md for the Cloudflare tunnel setup
# OLLAMA_URL: full URL to your tunneled Ollama (e.g. https://ollama.your-domain.com)
# Leave OLLAMA_ENABLED unset to enable. Set to "false" to hard-disable.
# OLLAMA_URL="https://ollama.your-domain.com"
# OLLAMA_ENABLED="false"

# Render sets these automatically — no need to set in the dashboard.
# PORT=10000
# NODE_ENV=production