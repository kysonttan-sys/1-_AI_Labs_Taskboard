# Database connection string
#   Local dev:        postgresql://postgres@127.0.0.1:5433/taskboard_test
#   Render Postgres:  postgresql://user:pass@host/db?sslmode=require  (SSL REQUIRED on Render)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Session encryption secret (generate with: openssl rand -hex 32)
# Required in production. server.ts will throw on boot without it.
SESSION_SECRET=""

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

